{
  "name": "@drawcall/webgpu",
  "version": "0.1.1",
  "description": "WebGPU rendering and compute in browsers and GPU-less Node.js",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "node": "./src/index.js",
      "default": "./src/browser.js"
    }
  },
  "files": [
    "src",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/webgpu.git"
  },
  "scripts": {
    "build:native": "modal run native/cloud.py",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:cloud": "modal run test/cloud.py",
    "bench": "modal run test/cloud.py",
    "test:package": "node deps/consumer.js",
    "release:prepare": "node deps/release.js prepare",
    "release:publish": "node deps/release.js publish",
    "test:release": "node --test test/tools/release.test.js",
    "release:trust": "node deps/release.js trust"
  },
  "dependencies": {
    "detect-libc": "2.1.2",
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "@drawcall/webgpu-linux-x64": "0.1.1",
    "@drawcall/webgpu-linux-arm64": "0.1.1",
    "@drawcall/webgpu-darwin-x64": "0.1.1",
    "@drawcall/webgpu-darwin-arm64": "0.1.1",
    "@drawcall/webgpu-win32-x64": "0.1.1",
    "@drawcall/webgpu-linuxmusl-x64": "0.1.1",
    "@drawcall/webgpu-linuxmusl-arm64": "0.1.1",
    "@drawcall/webgpu-win32-arm64": "0.1.1"
  },
  "devDependencies": {
    "three": "0.186.1"
  }
}
